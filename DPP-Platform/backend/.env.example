// .env.example — copy to .env and fill in actual values
# ===========================================
# DPP Platform Backend Environment Variables
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS + QR code base URL)
FRONTEND_URL=http://localhost:4200

# Database (PostgreSQL)
DATABASE_URL=postgresql://dpp_admin:dpp_password@localhost:5432/dpp_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# File Storage (AWS S3 or Supabase)
S3_BUCKET=dpp-platform-files
S3_REGION=us-east-1
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Cloudflare (for CDN + DNS)
CLOUDFLARE_ZONE=your-cloudflare-zone-id

# Feature Flags
AUDIT_ENABLED=true
