# Dependencies
node_modules/
**/node_modules/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
# Keep example env files tracked
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/

# Angular cache
.angular/
**/.angular/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage directory used by tools like istanbul / jest
coverage/
